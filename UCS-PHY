# implementing UCS
import queue

def ucs(tree, root, goal):
    visited = set()
    pq = queue.PriorityQueue()

    # (cost, vertex)
    pq.put((0, root))

    while not pq.empty():
        cost, vertex = pq.get()

        if vertex in visited:
            continue

        visited.add(vertex)

        if vertex == goal:
            print("Goal found:", vertex)
            print("Cost:", cost)
            print("Visited:", visited)
            return

        for child, child_cost in tree[vertex]:
            if child not in visited:
                pq.put((cost + child_cost, child))

    print("Goal not found")


if __name__ == '__main__':  # dictionary

    tree = {
        1: [(2, 2), (3, 4)],
        2: [(4, 3), (5, 1)],
        3: [(6, 2)],
        4: [],
        5: [],
        6: []
    }

    ucs(tree, 1, 5)
